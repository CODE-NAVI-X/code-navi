# Deployment environment template. Never put a real key in this tracked file.
# Optional portable runtime paths and browser policy:
# CODE_NAVI_PROJECT_ROOT=/absolute/path/to/code-navi
# CODE_NAVI_DATA_DIR=/absolute/path/to/code-navi-data
# CODE_NAVI_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# CODE_NAVI_ALLOW_BROWSER_PROVIDER_CONFIG=false

CODE_NAVI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# OpenAI alternative:
# CODE_NAVI_PROVIDER=openai
# OPENAI_API_KEY=
# CODE_NAVI_MODEL=

# Source-restricted academic search. urllib automatically honors HTTP_PROXY/HTTPS_PROXY.
CODE_NAVI_ACADEMIC_OPENALEX_ENABLED=true
CODE_NAVI_ACADEMIC_CROSSREF_ENABLED=true
CODE_NAVI_ACADEMIC_ARXIV_ENABLED=true
CODE_NAVI_ACADEMIC_CACHE_TTL_SECONDS=3600
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
