# Code Navi — Caddy reverse proxy (TLS)
#
# Entry points:
#   - Public domain: https://91666.icu:25000
#   - LAN IP: https://192.168.0.2:25000
#   - Localhost: https://127.0.0.1:25000 / https://localhost:25000
#
# Uses the pre-existing certificate mounted from the NAS host:
#   /vol4/docker/xray/certs/91666.icu.pem  (cert, PEM format)
#   /vol4/docker/xray/certs/91666.icu.key  (private key)
#
# Routing (same-origin, no CORS):
#   everything except /api/*, /docs*, /openapi.json, /health is served by the
#   Next.js frontend; the rest is proxied to the FastAPI backend.

https://91666.icu:25000, https://192.168.0.2:25000, https://localhost:25000, https://127.0.0.1:25000, :25000 {
    tls /certs/91666.icu.pem /certs/91666.icu.key

    @api {
        path /api/* /docs* /openapi.json /health
    }
    reverse_proxy @api backend:8000
    reverse_proxy frontend:3000
}
